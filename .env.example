# Patch Stash — environment variable template
# Copy this file to .env and fill in the values.
# .env is excluded from git — never commit it.

# ── Authentication ─────────────────────────────────────────────────────────────
# Shared password for the login screen.
# If this is left unset (or the line is removed), authentication is completely
# disabled — correct for Tailscale-gated deployments where network membership
# is already the security boundary.
AUTH_PASSWORD=

# ── Session security ───────────────────────────────────────────────────────────
# Used to sign the session cookie. Set this to a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be set even if AUTH_PASSWORD is not — the cookie signing still runs.
SESSION_SECRET=change-this-to-a-long-random-string

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the server listens on inside the container.
# The docker-compose.yml maps this to the same port on the host by default.
PORT=3000

# ── Data directory ─────────────────────────────────────────────────────────────
# Where to store the SQLite database and uploaded files on the HOST machine.
# Can be an absolute path or a path relative to the docker-compose.yml file.
# Default is ./data (a 'data' folder next to docker-compose.yml).
DATA_DIR=./data
